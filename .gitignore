# Only project source, required resources and reproducible tooling at repository root.
/*
!/.github/
!/assets/
!/data/
!/licenses/
!/scripts/
!/tools/
!/.gitignore
!/.gitattributes
!/.prettierignore
!/eslint.config.cjs
!/index.html
!/package.json
!/package-lock.json
!/README.md
!/AGENTS.md

# Dependencies and generated site
/node_modules/
/_site/
/dist/
/coverage/

# Local test, review, performance and snapshot artifacts
/test-results/
/playwright-report/
/blob-report/
/.refactor-backups/
/.refactor-data-updates/
*.log
*.partial.json
*.tmp
*.temp
__pycache__/
*.py[cod]

# Local documentation, tests and review tools stay off GitHub.
/docs/
/tests/
/scripts/*
!/scripts/check-site.cjs
!/scripts/verify-offline.cjs
!/scripts/verify-startup.cjs
!/scripts/clean-css.cjs
!/scripts/data-update.cjs
!/scripts/fetch_weather.py
!/scripts/sync-major-festivals.cjs
!/scripts/sync-material-icons.cjs
!/scripts/sync-weather-cities.cjs
!/scripts/update-history.cjs
!/scripts/update-international-festivals.cjs
!/scripts/version-site.cjs
!/scripts/bundle-site.cjs
!/scripts/lib/
!/scripts/vendor/
/scripts/lib/*
!/scripts/lib/wiki-source.cjs

# Local configuration, credentials and editor files
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
